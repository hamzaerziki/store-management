{
  "openapi": "3.0.3",
  "info": {
    "title": "Safari Invest API v1",
    "version": "1.0.0",
    "description": "API versionnée, additive et parallèle aux routes /api historiques. Implémente les sections 7, 8 et l'addendum V2.1 du dossier technique. Réponses d'erreur standardisées, idempotency-key sur les opérations financières, ETag/row_version pour la concurrence, pagination et filtrage.",
    "contact": { "name": "Safari Import Export — Équipe Application" }
  },
  "servers": [{ "url": "/api/v1", "description": "Router v1 monté par le serveur" }],
  "tags": [
    { "name": "Projets", "description": "Portefeuille, ouverture et fiscalité des projets" },
    { "name": "Finance", "description": "Budgets, devis, approbations, engagements, factures, paiements" },
    { "name": "Planning", "description": "Lots, tâches et avancement" },
    { "name": "Pilotage", "description": "Dashboard Section 8 et journal d'audit" },
    { "name": "V2.1 TVA", "description": "Référentiel TVA historisé et calculs multi-taux" },
    { "name": "V2.1 Notifications", "description": "Centre de notifications, règles et modèles" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/projects": {
      "post": {
        "tags": ["Projets"],
        "operationId": "createProjectV1",
        "summary": "Créer un projet (vérification enseigne + droits DD)",
        "description": "RG01 : code unique par année, enseigne active, responsable et date cible initiale immuable. Réservé aux rôles DD/admin.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectCreate" } } } },
        "responses": {
          "201": { "description": "Projet créé", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "project": { "$ref": "#/components/schemas/Project" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "get": {
        "tags": ["Projets"],
        "operationId": "listProjectsV1",
        "summary": "Liste des projets filtrée selon le rôle et les affectations",
        "description": "Lecture transversale pour admin/CDG/DD/DG, lecture limitée aux projets affectés pour IT/RMG/MG.",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "$ref": "#/components/parameters/Sort" },
          { "$ref": "#/components/parameters/Order" },
          { "name": "brand_id", "in": "query", "schema": { "type": "integer" }, "description": "Filtre enseigne" },
          { "name": "year", "in": "query", "schema": { "type": "integer" }, "description": "Exercice" },
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "owner_user_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "code", "in": "query", "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Recherche par nom ou code" }
        ],
        "responses": {
          "200": { "description": "Liste paginée", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Paginated" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } } } }] } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/budgets/{id}/submit": {
      "post": {
        "tags": ["Finance"],
        "operationId": "submitBudgetV1",
        "summary": "Soumettre une version de budget au CDG",
        "description": "Crée une demande d'approbation à l'étape CDG et publie 'demande_soumise' (et 'revision_budget_soumise' pour une révision).",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object", "properties": { "justification": { "type": "string" }, "reason": { "type": "string" } } } } } },
        "responses": {
          "201": { "description": "Budget soumis", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "approval_request": { "$ref": "#/components/schemas/ApprovalRequest" }, "budget": { "type": "object" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/quotes/{id}/submit": {
      "post": {
        "tags": ["Finance"],
        "operationId": "submitQuoteV1",
        "summary": "Soumettre une version de devis au CDG",
        "description": "RG04/RG05 : devis versionné, lié à un lot, avec instantané fiscal par ligne afin qu'un changement de taux n'altère pas les documents validés.",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
        "responses": {
          "201": { "description": "Devis soumis", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "approval_request": { "$ref": "#/components/schemas/ApprovalRequest" }, "quote": { "type": "object" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/approvals/{id}/decisions": {
      "post": {
        "tags": ["Finance"],
        "operationId": "decideApprovalV1",
        "summary": "Décision CDG → DD → DG avec contrôle de concurrence",
        "description": "RG06/RG19/RG20 : contrôle strict de l'étape, du rôle, de la version, de l'acteur, garde-fou de concurrence (SELECT FOR UPDATE + UPDATE conditionnel sur row_version) et empreinte SHA-256 du document. Transaction unique ; notifications publiées après commit.",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApprovalDecision" } } } },
        "responses": {
          "200": { "description": "Décision enregistrée", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "approval_request": { "$ref": "#/components/schemas/ApprovalRequest" }, "decision": { "$ref": "#/components/schemas/ApprovalDecisionRecord" }, "object": { "type": "object" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" }
        }
      }
    },
    "/commitments": {
      "post": {
        "tags": ["Finance"],
        "operationId": "createCommitmentV1",
        "summary": "Créer un engagement depuis un devis approuvé et le budget disponible",
        "description": "RG07/RG08 : devis approuvé obligatoire, budget disponible vérifié sous verrou, lignes et instantanés fiscaux conservés. Opération idempotente.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommitmentCreate" } } } },
        "responses": {
          "201": { "description": "Engagement créé", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "X-Idempotent-Replay": { "$ref": "#/components/headers/IdempotentReplay" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "commitment": { "type": "object" }, "budget": { "$ref": "#/components/schemas/BudgetAvailability" }, "replay": { "type": "boolean" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/invoices": {
      "post": {
        "tags": ["Finance"],
        "operationId": "createInvoiceV1",
        "summary": "Créer une facture contrôlée reliée à un engagement",
        "description": "RG09/RG18/RG20 : engagement autorisé, référence unique par prestataire, cohérence HT + TVA = TTC, contrôle du dépassement. Opération idempotente.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceCreate" } } } },
        "responses": {
          "201": { "description": "Facture créée", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "X-Idempotent-Replay": { "$ref": "#/components/headers/IdempotentReplay" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "invoice": { "type": "object" }, "replay": { "type": "boolean" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/payments": {
      "post": {
        "tags": ["Finance"],
        "operationId": "createPaymentV1",
        "summary": "Saisir un paiement CDG sur justificatif Finance",
        "description": "RG10/RG11/RG20 : réservé à CDG, justificatif Finance obligatoire, montant <= solde net de la facture. Opération idempotente.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentCreate" } } } },
        "responses": {
          "201": { "description": "Paiement saisi", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "X-Idempotent-Replay": { "$ref": "#/components/headers/IdempotentReplay" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "payment": { "type": "object" }, "balance_after": { "type": "number" }, "replay": { "type": "boolean" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/tasks/{id}/progress": {
      "patch": {
        "tags": ["Planning"],
        "operationId": "updateTaskProgressV1",
        "summary": "Mettre à jour l'avancement d'une tâche (bornes 0..100)",
        "description": "RG12/RG13 : bornage 0-100, justification obligatoire sur changement, audit avant/après et recalcul de l'avancement pondéré du projet.",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskProgress" } } } },
        "responses": {
          "200": { "description": "Avancement mis à jour", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "task": { "type": "object" }, "project_progress": { "type": "number" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" }
        }
      }
    },
    "/change-requests": {
      "post": {
        "tags": ["Finance"],
        "operationId": "createChangeRequestV1",
        "summary": "Déclarer un imprévu ou un avenant",
        "description": "RG14 : demande de changement avec impact financier et délai, devis complémentaire et validation avant avenant.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangeRequestCreate" } } } },
        "responses": {
          "201": { "description": "Demande de changement créée", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "change_request": { "type": "object" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/projects/{id}/opening/submit": {
      "post": {
        "tags": ["Projets"],
        "operationId": "submitOpeningV1",
        "summary": "Soumettre le dossier de préouverture (DD)",
        "description": "RG15 : checklist bloquante complète obligatoire, validation DD enregistrée et auditée.",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object", "properties": { "comment": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "Dossier soumis au DD", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "opening_decision": { "type": "object" }, "project": { "$ref": "#/components/schemas/Project" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/projects/{id}/opening/decision": {
      "post": {
        "tags": ["Projets"],
        "operationId": "decideOpeningV1",
        "summary": "Décision finale d'ouverture (DG) — autorisation ou refus",
        "description": "RG15 : impossible si la checklist bloquante est incomplète ou si le DD n'a pas validé. Le refus est supporté avec motif obligatoire et historisation.",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OpeningDecision" } } } },
        "responses": {
          "200": { "description": "Décision DG enregistrée", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "opening_decision": { "type": "object" }, "project": { "$ref": "#/components/schemas/Project" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/dashboard": {
      "get": {
        "tags": ["Pilotage"],
        "operationId": "getDashboardV1",
        "summary": "KPI paginés et datés selon les formules de la Section 8",
        "description": "Retourne generated_at, budget en vigueur, engagement net, disponible, facturé net, reste à payer, coût final estimé, avancement pondéré, écarts, criticité des risques et alertes.",
        "parameters": [
          { "name": "year", "in": "query", "schema": { "type": "integer" } },
          { "name": "brand_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "owner_user_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "KPI du portefeuille", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Dashboard" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/audit-events": {
      "get": {
        "tags": ["Pilotage"],
        "operationId": "listAuditEventsV1",
        "summary": "Lecture paginée et permission-scopée du journal d'audit",
        "description": "RG19 : acteur, date UTC, rôle, version, commentaire, empreinte et correlation_id conservés. Accès réservé aux rôles de supervision financière.",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "name": "actor_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "action", "in": "query", "schema": { "type": "string" } },
          { "name": "object_type", "in": "query", "schema": { "type": "string" } },
          { "name": "object_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "correlation_id", "in": "query", "schema": { "type": "string" } },
          { "name": "project_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": { "description": "Événements d'audit paginés", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Paginated" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/AuditEvent" } } } }] } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/tax-rates": {
      "get": {
        "tags": ["V2.1 TVA"],
        "operationId": "listTaxRatesV1",
        "summary": "Référentiel des taux de TVA historisés",
        "description": "Différencie taxable, exonéré et hors champ ; filtrage par date d'effet.",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "name": "code", "in": "query", "schema": { "type": "string" } },
          { "name": "regime", "in": "query", "schema": { "type": "string", "enum": ["taxable", "exonere", "hors_champ"] } },
          { "name": "active", "in": "query", "schema": { "type": "boolean" } },
          { "name": "valid_on", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": { "description": "Taux paginés", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Paginated" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/TaxRate" } } } }] } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["V2.1 TVA"],
        "operationId": "createTaxRateV1",
        "summary": "Créer un taux de TVA (administration)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaxRateCreate" } } } },
        "responses": {
          "201": { "description": "Taux créé", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "tax_rate": { "$ref": "#/components/schemas/TaxRate" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/tax-rates/{id}": {
      "patch": {
        "tags": ["V2.1 TVA"],
        "operationId": "patchTaxRateV1",
        "summary": "Modifier un taux avec date d'effet (jamais rétroactivement sur un document validé)",
        "description": "Si le taux est référencé par des lignes de documents, effective_from crée une nouvelle version et clôt la précédente la veille ; les documents approuvés conservent leur instantané fiscal.",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/TaxRateCreate" }, { "type": "object", "properties": { "effective_from": { "type": "string", "format": "date" }, "new_code": { "type": "string" } } }] } } } },
        "responses": {
          "200": { "description": "Taux mis à jour ou nouvelle version créée", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "type": "object", "properties": { "tax_rate": { "$ref": "#/components/schemas/TaxRate" }, "supersedes": { "type": "integer" }, "previous_valid_to": { "type": "string", "format": "date" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" }
        }
      }
    },
    "/notification-rules": {
      "get": {
        "tags": ["V2.1 Notifications"],
        "operationId": "listNotificationRulesV1",
        "summary": "Règles d'abonnement, canaux, relances et escalades",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "name": "event_key", "in": "query", "schema": { "type": "string" } },
          { "name": "channel", "in": "query", "schema": { "type": "string", "enum": ["internal", "email"] } },
          { "name": "enabled", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": { "description": "Règles paginées", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Paginated" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/NotificationRule" } }, "known_events": { "type": "array", "items": { "type": "string" } } } }] } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "tags": ["V2.1 Notifications"],
        "operationId": "upsertNotificationRulesV1",
        "summary": "Créer ou mettre à jour des règles (les règles critiques ne peuvent être désactivées)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "oneOf": [{ "type": "array", "items": { "$ref": "#/components/schemas/NotificationRule" } }, { "type": "object", "properties": { "rules": { "type": "array", "items": { "$ref": "#/components/schemas/NotificationRule" } } } }] } } } },
        "responses": {
          "200": { "description": "Règles enregistrées", "content": { "application/json": { "schema": { "type": "object", "properties": { "rules": { "type": "array", "items": { "$ref": "#/components/schemas/NotificationRule" } } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/notification-templates": {
      "get": {
        "tags": ["V2.1 Notifications"],
        "operationId": "listNotificationTemplatesV1",
        "summary": "Modèles de messages par événement, canal et langue",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "name": "event_key", "in": "query", "schema": { "type": "string" } },
          { "name": "channel", "in": "query", "schema": { "type": "string", "enum": ["internal", "email"] } },
          { "name": "locale", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Modèles paginés", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Paginated" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/NotificationTemplate" } } } }] } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "tags": ["V2.1 Notifications"],
        "operationId": "upsertNotificationTemplatesV1",
        "summary": "Créer ou mettre à jour des modèles de notification",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "oneOf": [{ "type": "array", "items": { "$ref": "#/components/schemas/NotificationTemplate" } }, { "type": "object", "properties": { "templates": { "type": "array", "items": { "$ref": "#/components/schemas/NotificationTemplate" } } } }] } } } },
        "responses": {
          "200": { "description": "Modèles enregistrés", "content": { "application/json": { "schema": { "type": "object", "properties": { "templates": { "type": "array", "items": { "$ref": "#/components/schemas/NotificationTemplate" } } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/documents/{id}/calculate-totals": {
      "post": {
        "tags": ["V2.1 TVA"],
        "operationId": "calculateDocumentTotalsV1",
        "summary": "Simulation HT / TVA / TTC multi-taux avec instantanés",
        "description": "REC-NTV-06 à 10 : recalcul à partir des taux instantanés, arrondi par ligne ou par document, distinction 0 % taxable / exonéré, TVA récupérable et coût d'investissement net. Les documents approuvés sont en lecture seule.",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TotalsCalculation" } } } },
        "responses": {
          "200": { "description": "Totaux calculés", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TotalsResult" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/projects/{id}/tax-summary": {
      "get": {
        "tags": ["V2.1 TVA"],
        "operationId": "getProjectTaxSummaryV1",
        "summary": "TVA facturée, TVA récupérable et coût net d'investissement par projet",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
        "responses": {
          "200": { "description": "Récapitulatif fiscal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaxSummary" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/notifications": {
      "get": {
        "tags": ["V2.1 Notifications"],
        "operationId": "listNotificationsV1",
        "summary": "Centre de notifications de l'utilisateur courant (badge non lu, lien profond)",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "name": "unread_only", "in": "query", "schema": { "type": "boolean" } },
          { "name": "event_type", "in": "query", "schema": { "type": "string" } },
          { "name": "channel", "in": "query", "schema": { "type": "string", "enum": ["internal", "email"] } },
          { "name": "user_id", "in": "query", "schema": { "type": "integer" }, "description": "Réservé à admin" }
        ],
        "responses": {
          "200": { "description": "Notifications paginées", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Paginated" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Notification" } }, "unread_count": { "type": "integer" } } }] } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/notifications/{id}/read": {
      "patch": {
        "tags": ["V2.1 Notifications"],
        "operationId": "markNotificationReadV1",
        "summary": "Marquer une notification comme lue",
        "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
        "responses": {
          "200": { "description": "Notification mise à jour", "content": { "application/json": { "schema": { "type": "object", "properties": { "notification": { "$ref": "#/components/schemas/Notification" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT émis par /api/auth (Entra ID en production)."
      }
    },
    "headers": {
      "ETag": { "description": "Version optimiste (row_version / version / revision) de la ressource", "schema": { "type": "string" }, "example": "\"12\"" },
      "IdempotentReplay": { "description": "Présent à true lorsqu'une réponse est rejouée depuis le cache d'idempotence", "schema": { "type": "boolean" } }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Clé unique envoyée par le client pour les opérations financières (rejeu sans doublon, table v1_idempotency avec repli mémoire).",
        "schema": { "type": "string", "minLength": 1, "maxLength": 120 },
        "example": "commit-2027-store-4-001"
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": false,
        "description": "ETag ou row_version attendu ; désaccord => 412 PRECONDITION_FAILED.",
        "schema": { "type": "string" },
        "example": "\"7\""
      },
      "Page": { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "PageSize": { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "Sort": { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["id", "code", "name", "city", "year", "status", "created_at"] } },
      "Order": { "name": "order", "in": "query", "required": false, "schema": { "type": "string", "enum": ["ASC", "DESC"], "default": "DESC" } },
      "ObjectId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }
    },
    "responses": {
      "BadRequest": { "description": "Paramètres ou règles métier invalides", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Authentification requise ou session expirée", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Rôle, affectation ou état non autorisé", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Ressource introuvable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Conflit métier, doublon, version ou disponibilité", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "PreconditionFailed": { "description": "If-Match obsolète", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message", "correlation_id", "details"],
        "properties": {
          "code": { "type": "string", "example": "CONFLICT" },
          "message": { "type": "string", "example": "Dépassement du budget disponible : révision budgétaire à approuver" },
          "correlation_id": { "type": "string", "format": "uuid" },
          "details": { "type": "object", "additionalProperties": true }
        }
      },
      "Paginated": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "type": "object" } },
          "pagination": {
            "type": "object",
            "properties": {
              "page": { "type": "integer" },
              "pageSize": { "type": "integer" },
              "total": { "type": "integer" },
              "totalPages": { "type": "integer" },
              "hasNext": { "type": "boolean" },
              "hasPrevious": { "type": "boolean" }
            }
          }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "required": ["code", "brand_id", "title", "city", "year", "owner_user_id", "initial_open_date"],
        "properties": {
          "code": { "type": "string" },
          "brand_id": { "type": "integer" },
          "title": { "type": "string" },
          "city": { "type": "string" },
          "address": { "type": "string" },
          "area_m2": { "type": "number" },
          "year": { "type": "integer" },
          "owner_user_id": { "type": "integer" },
          "initial_open_date": { "type": "string", "format": "date" },
          "forecast_open_date": { "type": "string", "format": "date" },
          "budget": { "type": "number" }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "code": { "type": "string" },
          "brand_id": { "type": "integer" },
          "brand": { "type": "string" },
          "title": { "type": "string" },
          "city": { "type": "string" },
          "year": { "type": "integer" },
          "initial_open_date": { "type": "string", "format": "date" },
          "revised_open_date": { "type": "string", "format": "date" },
          "status": { "type": "string" },
          "version": { "type": "integer" },
          "row_version": { "type": "integer" },
          "budget": { "type": "number" },
          "etag": { "type": "string" }
        }
      },
      "ApprovalRequest": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "object_type": { "type": "string", "enum": ["budget", "quote"] },
          "object_id": { "type": "integer" },
          "object_version": { "type": "integer" },
          "current_step": { "type": "string", "enum": ["CDG", "DD", "DG"] },
          "status": { "type": "string" },
          "submitted_by": { "type": "integer" },
          "row_version": { "type": "integer" }
        }
      },
      "ApprovalDecision": {
        "type": "object",
        "required": ["decision"],
        "properties": {
          "decision": { "type": "string", "enum": ["approved", "rejected", "correction"] },
          "comment": { "type": "string", "description": "Motif obligatoire en cas de rejet ou de correction" },
          "version": { "type": "integer", "description": "Version attendue du document (contrôle de concurrence)" },
          "row_version": { "type": "integer" },
          "document_hash": { "type": "string", "description": "Empreinte SHA-256 fournie par le client ; sinon calculée côté serveur" },
          "actor_id": { "type": "integer", "description": "Doit correspondre à l'utilisateur authentifié" }
        }
      },
      "ApprovalDecisionRecord": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "request_id": { "type": "integer" },
          "step": { "type": "string" },
          "actor_id": { "type": "integer" },
          "decision": { "type": "string" },
          "comment": { "type": "string" },
          "decided_at": { "type": "string", "format": "date-time" },
          "document_hash": { "type": "string" }
        }
      },
      "DocumentLineInput": {
        "type": "object",
        "properties": {
          "quantity": { "type": "number" },
          "unit_price_ht": { "type": "number" },
          "discount_ht": { "type": "number" },
          "base_ht": { "type": "number" },
          "tax_rate_id": { "type": "integer" },
          "tax_rate_code": { "type": "string" },
          "tax_rate_snapshot": { "type": "number" },
          "vat_rate": { "type": "number" },
          "regime": { "type": "string", "enum": ["taxable", "exonere", "hors_champ"] },
          "rounding_rule": { "type": "string", "enum": ["line", "document", "half_up", "half_down", "floor", "ceil"] },
          "fiscal_reference": { "type": "string" },
          "fiscal_date": { "type": "string", "format": "date" },
          "deductible_percentage": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      },
      "CommitmentCreate": {
        "type": "object",
        "required": ["quote_id"],
        "properties": {
          "quote_id": { "type": "integer" },
          "vendor_id": { "type": "integer" },
          "order_ref": { "type": "string" },
          "amount": { "type": "number" },
          "date": { "type": "string", "format": "date" },
          "currency": { "type": "string" },
          "rounding_rule": { "type": "string" },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/DocumentLineInput" } }
        }
      },
      "InvoiceCreate": {
        "type": "object",
        "required": ["commitment_id", "invoice_ref", "amount_ttc"],
        "properties": {
          "commitment_id": { "type": "integer", "description": "Alias : purchase_order_id" },
          "vendor_id": { "type": "integer" },
          "invoice_ref": { "type": "string" },
          "invoice_date": { "type": "string", "format": "date" },
          "due_date": { "type": "string", "format": "date" },
          "amount_ht": { "type": "number" },
          "vat_amount": { "type": "number" },
          "amount_ttc": { "type": "number" },
          "document_id": { "type": "integer" },
          "currency": { "type": "string" },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/DocumentLineInput" } }
        }
      },
      "PaymentCreate": {
        "type": "object",
        "required": ["invoice_id", "amount", "finance_reference"],
        "properties": {
          "invoice_id": { "type": "integer" },
          "amount": { "type": "number", "minimum": 0.01 },
          "payment_date": { "type": "string", "format": "date" },
          "finance_reference": { "type": "string" },
          "proof_document_id": { "type": "integer" },
          "support_name": { "type": "string" },
          "support_url": { "type": "string" },
          "method": { "type": "string" },
          "reference": { "type": "string" }
        }
      },
      "TaskProgress": {
        "type": "object",
        "required": ["progress_pct"],
        "properties": {
          "progress_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "Valeur bornée à 0..100 côté serveur" },
          "justification": { "type": "string", "description": "Obligatoire lorsque la valeur change" }
        }
      },
      "ChangeRequestCreate": {
        "type": "object",
        "required": ["project_id", "reason"],
        "properties": {
          "project_id": { "type": "integer" },
          "lot_id": { "type": "integer" },
          "title": { "type": "string" },
          "reason": { "type": "string" },
          "description": { "type": "string" },
          "impact_amount": { "type": "number" },
          "impact_days": { "type": "integer" },
          "quote_id": { "type": "integer" }
        }
      },
      "OpeningDecision": {
        "type": "object",
        "required": ["decision"],
        "properties": {
          "decision": { "type": "string", "enum": ["autorisee", "refusee"] },
          "comment": { "type": "string", "description": "Motif obligatoire en cas de refus" }
        }
      },
      "BudgetAvailability": {
        "type": "object",
        "properties": {
          "budget": { "type": "number" },
          "engaged": { "type": "number" },
          "available": { "type": "number" }
        }
      },
      "Section8": {
        "type": "object",
        "properties": {
          "budget_en_vigueur": { "type": "number" },
          "engagement_net": { "type": "number" },
          "disponible_a_engager": { "type": "number" },
          "alerte_budget": { "type": "string", "enum": ["normal", "epuise", "depassement"] },
          "facture_net": { "type": "number" },
          "paiements_nets": { "type": "number" },
          "reste_a_payer": { "type": "number" },
          "cout_final_estime": { "type": "number" },
          "avancement_projet": { "type": "number" },
          "avancement_theorique": { "type": "number" },
          "ecart_planning": { "type": "number" },
          "retard_ouverture_jours": { "type": "integer" }
        }
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "generated_at": { "type": "string", "format": "date-time" },
          "filters": { "type": "object" },
          "kpis": { "allOf": [{ "$ref": "#/components/schemas/Section8" }, { "type": "object", "properties": { "projets": { "type": "integer" }, "retards_ouverture": { "type": "integer" }, "risques": { "type": "object" } } }] },
          "projects": { "type": "array", "items": { "$ref": "#/components/schemas/Section8" } },
          "alerts": { "type": "array", "items": { "type": "object" } }
        }
      },
      "AuditEvent": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "actor_id": { "type": "integer" },
          "actor_name": { "type": "string" },
          "action": { "type": "string" },
          "object_type": { "type": "string" },
          "object_id": { "type": "integer" },
          "before_json": { "type": "object" },
          "after_json": { "type": "object" },
          "occurred_at": { "type": "string", "format": "date-time" },
          "correlation_id": { "type": "string" }
        }
      },
      "TaxRate": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "code": { "type": "string" },
          "label": { "type": "string" },
          "rate": { "type": "number" },
          "regime": { "type": "string", "enum": ["taxable", "exonere", "hors_champ"] },
          "valid_from": { "type": "string", "format": "date" },
          "valid_to": { "type": "string", "format": "date" },
          "active": { "type": "boolean" },
          "row_version": { "type": "integer" }
        }
      },
      "TaxRateCreate": {
        "type": "object",
        "required": ["code", "label", "rate", "regime"],
        "properties": {
          "code": { "type": "string" },
          "label": { "type": "string" },
          "rate": { "type": "number", "minimum": 0 },
          "regime": { "type": "string", "enum": ["taxable", "exonere", "hors_champ"] },
          "valid_from": { "type": "string", "format": "date" },
          "valid_to": { "type": "string", "format": "date" },
          "active": { "type": "boolean" }
        }
      },
      "NotificationRule": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "event_key": { "type": "string" },
          "recipient_roles": { "type": "array", "items": { "type": "string" } },
          "channel": { "type": "string", "enum": ["internal", "email"] },
          "reminder_delay": { "type": "integer" },
          "escalation_delay": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "disableable": { "type": "boolean", "description": "false pour les notifications critiques de validation" }
        }
      },
      "NotificationTemplate": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "event_key": { "type": "string" },
          "channel": { "type": "string", "enum": ["internal", "email"] },
          "locale": { "type": "string" },
          "subject_template": { "type": "string" },
          "body_template": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      },
      "TotalsCalculation": {
        "type": "object",
        "properties": {
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/DocumentLineInput" } },
          "rounding_rule": { "type": "string", "enum": ["line", "document", "half_up", "half_down", "floor", "ceil"], "default": "line" },
          "deductible_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
          "persist": { "type": "boolean", "description": "Enregistre les instantanés uniquement si le document n'est pas approuvé" }
        }
      },
      "TotalsResult": {
        "type": "object",
        "properties": {
          "document_id": { "type": "integer" },
          "lines": { "type": "array", "items": { "type": "object" } },
          "by_rate": { "type": "array", "items": { "type": "object" } },
          "totals": { "type": "object", "properties": { "base_ht": { "type": "number" }, "tax_amount": { "type": "number" }, "total_ttc": { "type": "number" } } },
          "recoverable_vat": { "type": "number" },
          "net_investment_cost": { "type": "number" },
          "rounding_rule": { "type": "string" },
          "read_only": { "type": "boolean" },
          "persisted": { "type": "boolean" },
          "generated_at": { "type": "string", "format": "date-time" }
        }
      },
      "TaxSummary": {
        "type": "object",
        "properties": {
          "project_id": { "type": "integer" },
          "generated_at": { "type": "string", "format": "date-time" },
          "billed_vat": { "type": "number" },
          "recoverable_vat": { "type": "number" },
          "net_investment_cost": { "type": "number" },
          "by_regime": { "type": "object" },
          "by_rate": { "type": "array", "items": { "type": "object" } },
          "source": { "type": "string" }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "integer" },
          "message": { "type": "string" },
          "type": { "type": "string" },
          "read": { "type": "boolean" },
          "event_type": { "type": "string" },
          "object_type": { "type": "string" },
          "object_id": { "type": "integer" },
          "channel": { "type": "string", "enum": ["internal", "email"] },
          "status": { "type": "string" },
          "retry_count": { "type": "integer" },
          "last_error": { "type": "string" },
          "deep_link": { "type": "string", "example": "/projects/4/approvals/12" },
          "created_at": { "type": "string", "format": "date-time" },
          "read_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
