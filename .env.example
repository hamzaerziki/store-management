# Safari Store Opening Tracker — environment
DB_NAME=safari
DB_USER=safari
DB_PASSWORD=safari_secret
DB_PORT=5432

JWT_SECRET=replace_with_output_of_openssl_rand_base64_48
JWT_EXPIRES=12h
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=20000
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=10
REQUEST_TIMEOUT_MS=30000

# Email notifications (set MAIL_ENABLED=true and fill SMTP details to deliver real emails)
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@safari.local

API_PORT=4000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000/api
